# Copy to .env and adjust.  cp .env.example .env

# ── Databases ───────────────────────────────────────────────
# Control DB (SaaS management: tenants, plans, subscriptions)
CONTROL_DATABASE_URL="postgresql://pos:pos@localhost:5432/pos_control"
# Tenant DB URL template. {db} is replaced with each tenant's database name (e.g. pos_t_demo).
# The database user needs the CREATEDB privilege so new tenants can be provisioned.
TENANT_DATABASE_URL_TEMPLATE="postgresql://pos:pos@localhost:5432/{db}"
# Max cached tenant Prisma clients, and pg pool size per tenant
TENANT_CLIENT_CACHE_MAX=50
TENANT_DB_POOL_MAX=5

# ── Security ────────────────────────────────────────────────
# Random string, at least 32 characters:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string-0123456789"
SESSION_TTL_HOURS=12
# Cookies are "Secure" (HTTPS only) when NODE_ENV=production. Set to "false" only for plain-HTTP testing.
# COOKIE_SECURE="false"

# ── Platform admin (created / updated by `npm run setup`) ──
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="ChangeMe123!"

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Phone POS"
# Business timezone ("today's sales", document year)
TZ="Asia/Singapore"
