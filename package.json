{
  "name": "pos-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant POS SaaS for mobile phone shops (Next.js + Prisma + PostgreSQL)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate --config prisma.control.config.ts && prisma generate --config prisma.tenant.config.ts",
    "postinstall": "npm run prisma:generate",
    "db:push:control": "prisma db push --config prisma.control.config.ts",
    "tenants:sync": "tsx scripts/tenants-sync.ts",
    "tenant:create": "tsx scripts/tenant-create.ts",
    "setup": "tsx scripts/setup.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "inventory:check": "tsx scripts/check-inventory.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.2.0",
    "next": "^16.4.1",
    "pg": "^8.16.0",
    "prisma": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
